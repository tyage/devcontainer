{
  "name": "${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },

  "mounts": [
    "source=devcontainer-agent-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=devcontainer-agent-codex-${devcontainerId},target=/home/vscode/.codex,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code"
      ]
    }
  },

  "remoteUser": "vscode"
}
